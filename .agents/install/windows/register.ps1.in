# GENERATED BY seo-kit
$ErrorActionPreference = 'Stop'
$sid = [System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value
$name = 'SEO Kit Update-' + $sid
$existing = Get-ScheduledTask -TaskName $name -ErrorAction SilentlyContinue
if ($existing -and $existing.Description -ne 'GENERATED BY seo-kit') { throw 'Task name belongs to another application' }
$user = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
$hostPath = Join-Path $env:SystemRoot 'System32\wscript.exe'
if (-not (Test-Path -LiteralPath $hostPath)) { throw 'Windows Script Host is required for windowless automatic updates' }
$action = New-ScheduledTaskAction -Execute $hostPath -Argument {{ARGUMENTS}} -WorkingDirectory {{BASE}}
$login = New-ScheduledTaskTrigger -AtLogOn -User $user
$midnight = New-ScheduledTaskTrigger -Daily -At '00:00'
$principal = New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel Limited
$settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -MultipleInstances IgnoreNew -ExecutionTimeLimit (New-TimeSpan -Minutes 10)
Register-ScheduledTask -TaskName $name -Description 'GENERATED BY seo-kit' -Action $action -Trigger @($login, $midnight) -Principal $principal -Settings $settings -Force | Out-Null
